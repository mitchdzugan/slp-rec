{
  "name": "slp-rec",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:mk": "npx babel index.js --out-file dist/slp-rec.cjs",
    "build:exe": "node -e 'import(`make-executable`).then(me => me.makeExecutable(`./dist/slp-rec.cjs`))'",
    "build": "npx run-s build:mk build:exe",
    "prepare": "npm run build",
    "start": "npx babel-node -- index.js"
  },
  "bin": "./dist/slp-rec.cjs",
  "dependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/node": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@logdna/tail-file": "^4.0.2",
    "@slippi/slippi-js": "^9.1.1",
    "babel-plugin-inline-import": "^3.0.0",
    "chmod": "^0.2.1",
    "cli-progress": "^3.12.0",
    "command-line-args": "^6.0.1",
    "command-line-usage": "^7.0.3",
    "enet": "^0.2.9",
    "env-paths": "^3.0.0",
    "execa": "^9.6.1",
    "extensionless": "^2.0.6",
    "hash-it": "^7.0.1",
    "ini": "^6.0.0",
    "make-executable": "^2.0.2",
    "mkdirp": "^3.0.1",
    "npm-run-all": "^4.1.5",
    "smol-toml": "^1.6.1",
    "tail-file-stream": "^0.2.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
